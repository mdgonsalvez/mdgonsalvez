<?xml version="1.0" encoding="UTF-8"?>
<!--
  PrivacyInfo.xcprivacy
  PassportQuest

  Apple Privacy Manifest. Passport Quest collects NO data, makes NO network
  calls, and uses NO tracking. This manifest declares exactly that, which is
  required for App Store submission and especially scrutinised for the Kids
  Category.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The app does not track users across apps/websites. -->
    <key>NSPrivacyTracking</key>
    <false/>

    <!-- No tracking domains. -->
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!-- No data collected from this app. -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <!-- Required-reason API: UserDefaults is used only for local game saves. -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- CA92.1: Access info from same app, not sent off-device. -->
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
